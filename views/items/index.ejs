<%- contentFor('body') %>
    <div class="row">
        <div class="col">
            <div class="page-header mb-3">
                <h1>Items</h1>
                <div class="actions">
                    <form action="/ai/run" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-secondary"
                            onclick="return confirm('Run AI extraction for all pending tasks now?')">Run AI on pending</button>
                    </form>
                    <a href="/stores" class="btn btn-outline-primary">Manage Stores</a>
                    <a href="/items/new" class="btn btn-primary">Add New Item</a>
                </div>
            </div>

            <% if (aiStarted) { %>
                <div class="alert alert-info">AI extraction started in the background. Refresh in a few minutes to see results.</div>
            <% } %>

            <% const dealsSuffix = dealsOnly ? '&deals=1' : ''; %>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="dealsOnlyToggle" <%= dealsOnly ? 'checked' : '' %>
                    onchange="var p = new URLSearchParams(window.location.search); if (this.checked) { p.set('deals', '1'); } else { p.delete('deals'); } var q = p.toString(); window.location.search = q ? '?' + q : '';">
                <label class="form-check-label" for="dealsOnlyToggle">
                    Show only available items below target price
                </label>
            </div>

            <% const sortOptions = [['name', 'Name'], ['store_name', 'Store'], ['target_price', 'Target Price'], ['current_price', 'Current Price']]; %>
            <select class="form-select mb-3 d-md-none" aria-label="Sort"
                onchange="window.location.href = this.value">
                <% sortOptions.forEach(([key, label]) => { ['asc', 'desc'].forEach(order => { %>
                    <option value="/?sort=<%= key %>&order=<%= order %><%= dealsSuffix %>" <%= currentSort === key && currentOrder === order ? 'selected' : '' %>>
                        Sort: <%= label %> <%= order === 'asc' ? '↑' : '↓' %>
                    </option>
                <% }); }); %>
            </select>

            <div class="table-responsive">
                <table class="table table-striped table-stack">
                    <thead>
                        <tr>
                            <th>
                                <a href="/?sort=name&order=<%= currentSort === 'name' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= dealsSuffix %>"
                                    class="text-decoration-none text-dark">
                                    Name
                                    <% if (currentSort==='name' ) { %>
                                        <i class="bi bi-arrow-<%= currentOrder === 'asc' ? 'up' : 'down' %>"></i>
                                        <% } %>
                                </a>
                            </th>
                            <th>
                                <a href="/?sort=store_name&order=<%= currentSort === 'store_name' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= dealsSuffix %>"
                                    class="text-decoration-none text-dark">
                                    Store
                                    <% if (currentSort==='store_name' ) { %>
                                        <i class="bi bi-arrow-<%= currentOrder === 'asc' ? 'up' : 'down' %>"></i>
                                        <% } %>
                                </a>
                            </th>
                            <th>
                                <a href="/?sort=target_price&order=<%= currentSort === 'target_price' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= dealsSuffix %>"
                                    class="text-decoration-none text-dark">
                                    Target Price
                                    <% if (currentSort==='target_price' ) { %>
                                        <i class="bi bi-arrow-<%= currentOrder === 'asc' ? 'up' : 'down' %>"></i>
                                        <% } %>
                                </a>
                            </th>
                            <th>
                                <a href="/?sort=current_price&order=<%= currentSort === 'current_price' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= dealsSuffix %>"
                                    class="text-decoration-none text-dark">
                                    Current Price
                                    <% if (currentSort==='current_price' ) { %>
                                        <i class="bi bi-arrow-<%= currentOrder === 'asc' ? 'up' : 'down' %>"></i>
                                        <% } %>
                                </a>
                            </th>
                            <th>Current Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(item=> { %>
                            <tr
                                class="<%= !item.enabled ? 'text-muted opacity-50' : (!item.enable_notifications ? 'opacity-75' : '') %>">
                                <td class="stack-title">
                                    <a href="<%= item.url %>" class="text-decoration-none">
                                        <%= item.name %>
                                    </a>
                                </td>
                                <td data-label="Store">
                                    <% if (item.store_name) { %>
                                        <a href="<%= item.store_website %>"
                                            class="text-decoration-none">
                                            <%= item.store_name %>
                                        </a>
                                        <% } else { %>
                                            <span class="text-muted">No store</span>
                                            <% } %>
                                </td>
                                <td data-label="Target">$<%= item.target_price.toFixed(2) %>
                                </td>
                                <td data-label="Current"><div>
                                    <% if (item.current_price) { %>
                                        <% const daysSincePrice=moment().diff(moment(item.price_timestamp), 'days' ); %>
                                            <% if (daysSincePrice> 3) { %>
                                                <i class="bi bi-exclamation-triangle-fill text-warning"
                                                    title="No successful scrape in 3+ days"></i>
                                                <% } %>
                                                    $<%= item.current_price.toFixed(2) %>
                                                        <% const priceDiff=((item.current_price - item.target_price) /
                                                            item.target_price * 100).toFixed(1) %>
                                                            <small
                                                                class="<%= priceDiff > 0 ? 'text-danger' : 'text-success' %>">
                                                                (<%= priceDiff> 0 ? '+' : '' %><%= priceDiff %>%)
                                                            </small>
                                                            <br>
                                                            <small class="text-muted">
                                                                (<%= moment(item.price_timestamp).fromNow() %>)
                                                            </small>
                                                            <% if (item.current_in_stock === 0) { %>
                                                                <br><span class="badge bg-warning text-dark">Out of stock</span>
                                                            <% } %>
                                                            <% if (item.current_available === 0) { %>
                                                                <br><span class="badge bg-secondary">Unavailable</span>
                                                            <% } %>
                                                            <% } else if (item.current_available === 0) { %>
                                                                <span class="badge bg-secondary">Unavailable</span>
                                                                <br>
                                                                <small class="text-muted">
                                                                    (<%= moment(item.price_timestamp).fromNow() %>)
                                                                </small>
                                                            <% } else if (item.current_in_stock === 0) { %>
                                                                <span class="badge bg-warning text-dark">Out of stock</span>
                                                                <br>
                                                                <small class="text-muted">
                                                                    (<%= moment(item.price_timestamp).fromNow() %>)
                                                                </small>
                                                            <% } else { %>
                                                                <i class="bi bi-exclamation-triangle-fill text-warning"
                                                                    title="No successful scrape in 3+ days"></i>
                                                                <span class="text-muted">No data yet</span>
                                                                <% } %>
                                </div></td>
                                <td data-label="Status"><div>
                                    <span class="badge <%= item.enabled ? 'bg-success' : 'bg-secondary' %>">
                                        <%= item.enabled ? 'Enabled' : 'Disabled' %>
                                    </span>
                                    <br>
                                    <small
                                        class="badge <%= item.enable_notifications ? 'bg-info' : 'bg-warning' %> mt-1">
                                        Notifications: <%= item.enable_notifications ? 'On' : 'Off' %>
                                    </small>
                                </div></td>
                                <td class="stack-actions">
                                    <a href="/items/<%= item.id %>" class="btn btn-sm btn-info">View</a>
                                    <a href="/items/<%= item.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                                    <form action="/items/<%= item.id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>